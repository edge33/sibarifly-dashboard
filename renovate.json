{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:pinDigests", "helpers:pinGitHubActionDigests"],
  "enabledManagers": [
    "npm",
    "dockerfile",
    "docker-compose",
    "github-actions",
    "cloudbuild",
    "custom.regex"
  ],
  "semanticCommits": "enabled",
  "automerge": false,
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
  "cloudbuild": {
    "managerFilePatterns": ["/(^|/)cloudbuild(?:\\.[^/]+)?\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update pnpm installed in Docker and Cloud Build alongside packageManager",
      "managerFilePatterns": ["/(^|/)Dockerfile$/", "/(^|/)cloudbuild(?:\\.[^/]+)?\\.ya?ml$/"],
      "matchStrings": ["npm install -g pnpm@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["sibarifly-dashboard-api"],
      "enabled": false
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies", "optionalDependencies"],
      "semanticCommitType": "fix"
    },
    {
      "matchManagers": ["dockerfile"],
      "semanticCommitType": "fix"
    },
    {
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm",
      "semanticCommitType": "chore"
    }
  ]
}
