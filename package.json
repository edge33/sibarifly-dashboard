{
  "name": "sibarifly-dashboard",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter sibarifly-dashboard-api dev",
    "dev:debug": "pnpm --filter sibarifly-dashboard-api dev:debug",
    "test": "pnpm --filter sibarifly-dashboard-api test",
    "test:coverage": "pnpm --filter sibarifly-dashboard-api test:coverage",
    "typecheck": "pnpm --filter sibarifly-dashboard-api typecheck",
    "prisma-generate": "pnpm --filter sibarifly-dashboard-api prisma-generate",
    "prisma-migrate": "pnpm --filter sibarifly-dashboard-api prisma-migrate",
    "lint": "biome check .",
    "format": "biome format --write .",
    "biome:migrate": "biome migrate --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.18.0"
}
